# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to Git!

# JWT Configuration
# Generate a secure secret with: openssl rand -base64 64
JWT_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-64
JWT_EXPIRATION=3600000

# Database Configuration (for production, change from H2 to PostgreSQL)
# DATABASE_URL=jdbc:postgresql://localhost:5432/oms
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your-database-password

# Ollama Configuration (if needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Server Configuration
# SERVER_PORT=8080
